{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RecoveryTime",
  "version": "0.1.1",
  "identifier": "com.recoverytime.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "https://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RecoveryTime",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
      "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' http://172.16.248.224 http://localhost:8080; img-src 'self' asset: https://asset.localhost http://localhost:9000 http://172.16.248.224 data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "http": {
      "scope": [
        "http://localhost:8080/*",
        "http://localhost:9000/*"
      ]
    }
  }
}
